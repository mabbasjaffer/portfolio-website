# Copy to .env.local for local development. Never commit .env.local.

# ----------------------------------------------------------------------------
# Design system preview gate
# ----------------------------------------------------------------------------
# /design-system is hidden in production by default. Set to "true" in the
# deployment environment to expose it (e.g. for design review).
SHOW_DESIGN_SYSTEM=false

# ----------------------------------------------------------------------------
# Case study passwords (added in step 7)
# ----------------------------------------------------------------------------
# One env var per protected case study, named CASE_STUDY_<SLUG>.
# Example:
# CASE_STUDY_VISA_MERCHANT_2026=correct-horse-battery-staple
